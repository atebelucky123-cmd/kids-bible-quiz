# Copy to .env and set to your computer's LAN IP (Windows: `ipconfig`,
# look for the Wi-Fi adapter's IPv4 address). "localhost" won't work here —
# on a physical phone, that would point at the phone itself, not this
# computer. In production this becomes the deployed Render API URL instead.
EXPO_PUBLIC_API_URL=http://192.168.1.100:4000
