// Kids Bible Quiz — database schema
// See Kids_Bible_Quiz_Claude_Build_Spec.md Section 18 for the source data model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // The running app queries through DATABASE_URL (Neon's pooled connection
  // in production — fine for ordinary queries). Prisma's own migration
  // commands (migrate deploy, migrate dev) always use directUrl instead,
  // since they need session-level advisory locks that a transaction-mode
  // pooler like Neon's doesn't support. Locally, where there's no pooler,
  // both env vars just point at the same database.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum AnswerOption {
  A
  B
  C
  D
}

enum AttemptStatus {
  IN_PROGRESS
  FINISHED
}

model User {
  id             Int      @id @default(autoincrement())
  firstName      String   @map("first_name")
  middleName     String?  @map("middle_name")
  lastName       String   @map("last_name")
  age            Int
  mobileNumber   String   @map("mobile_number")
  hobbies        String?
  favoriteColor  String?  @map("favorite_color")
  favoriteAnimal String?  @map("favorite_animal")
  passwordHash   String   @map("password_hash")
  role           Role     @default(STUDENT)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  attempts QuizAttempt[]

  @@index([firstName])
  @@map("users")
}

model Quiz {
  id               Int      @id @default(autoincrement())
  title            String
  ageMin           Int      @map("age_min")
  ageMax           Int      @map("age_max")
  timeLimitSeconds Int      @default(30) @map("time_limit_seconds")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  questions Question[]
  attempts  QuizAttempt[]

  @@index([ageMin, ageMax])
  @@index([isActive])
  @@map("quizzes")
}

model Question {
  id            Int          @id @default(autoincrement())
  quizId        Int          @map("quiz_id")
  questionText  String       @map("question_text")
  optionA       String       @map("option_a")
  optionB       String       @map("option_b")
  optionC       String       @map("option_c")
  optionD       String       @map("option_d")
  correctOption AnswerOption @map("correct_option")
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  // A question is meaningless without its quiz, and by the time a quiz is
  // deletable at all (see Quiz.attempts' onDelete note), none of its
  // questions have recorded answers either — so cascading here is safe.
  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([quizId])
  @@index([isActive])
  @@map("questions")
}

model QuizAttempt {
  id                   Int           @id @default(autoincrement())
  userId               Int           @map("user_id")
  quizId               Int           @map("quiz_id")
  status               AttemptStatus @default(IN_PROGRESS)
  // Fixed, ordered list of question IDs selected for this attempt at start time.
  // currentQuestionIndex is a position into this array (0-based).
  questionIds          Int[]         @map("question_ids")
  currentQuestionIndex Int           @default(0) @map("current_question_index")
  score                Int           @default(0)
  totalQuestions       Int           @map("total_questions")
  percentage           Float?
  timeLimitSeconds     Int           @map("time_limit_seconds")
  startedAt            DateTime      @default(now()) @map("started_at")
  lastActivityAt       DateTime      @default(now()) @updatedAt @map("last_activity_at")
  // When the current question was first shown to the student — its timer
  // counts from here. Null means the quiz has moved on to a question that
  // hasn't been fetched yet, so time spent on a "Well done" or "Time's up"
  // screen never eats into the next question.
  questionShownAt      DateTime?     @map("question_shown_at")
  // A skipped question the student has gone back to answer, and when they
  // opened it — it gets its own timer, separate from the current question's.
  revisitQuestionId    Int?          @map("revisit_question_id")
  revisitShownAt       DateTime?     @map("revisit_shown_at")
  completedAt          DateTime?     @map("completed_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // NoAction, not Restrict: a quiz with any attempts against it can't be
  // hard-deleted, must be deactivated instead — same reasoning and the same
  // Prisma/Postgres error-code gotcha as the Answer -> Question fix below.
  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: NoAction)
  answers Answer[]

  @@index([userId, status])
  @@map("quiz_attempts")
}

model Answer {
  id             Int          @id @default(autoincrement())
  attemptId      Int          @map("attempt_id")
  questionId     Int          @map("question_id")
  // Null = the student skipped the question or its timer ran out, so no
  // option was picked. Recorded anyway so the result review can show it.
  selectedOption AnswerOption? @map("selected_option")
  isCorrect      Boolean      @map("is_correct")
  // A null-answer row is either a skip (can be revisited and answered) or
  // the timer running out (closed for good — its answer has been shown).
  timedOut       Boolean      @default(false) @map("timed_out")
  answeredAt     DateTime     @default(now()) @map("answered_at")

  attempt  QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  // NoAction, not Restrict: both block deletion identically for us (we
  // never defer constraint checks), but Postgres raises RESTRICT
  // violations as SQLSTATE 23001, which Prisma's error engine doesn't map
  // to a known error code — deleteQuestion()'s P2003 catch (admin.service.ts)
  // would silently fall through to a generic 500 instead of the intended
  // "deactivate it instead" message. NoAction raises 23503, which Prisma
  // does recognize as P2003.
  question Question    @relation(fields: [questionId], references: [id], onDelete: NoAction)

  @@index([attemptId])
  @@index([questionId])
  @@map("answers")
}
