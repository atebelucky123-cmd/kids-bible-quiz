// Kids Bible Quiz — database schema
// See Kids_Bible_Quiz_Claude_Build_Spec.md Section 18 for the source data model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum AnswerOption {
  A
  B
  C
  D
}

enum AttemptStatus {
  IN_PROGRESS
  FINISHED
}

model User {
  id             Int      @id @default(autoincrement())
  firstName      String   @map("first_name")
  middleName     String?  @map("middle_name")
  lastName       String   @map("last_name")
  age            Int
  mobileNumber   String   @map("mobile_number")
  hobbies        String?
  favoriteColor  String?  @map("favorite_color")
  favoriteAnimal String?  @map("favorite_animal")
  passwordHash   String   @map("password_hash")
  role           Role     @default(STUDENT)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  attempts QuizAttempt[]

  @@index([firstName])
  @@map("users")
}

model Question {
  id           Int          @id @default(autoincrement())
  questionText String       @map("question_text")
  optionA      String       @map("option_a")
  optionB      String       @map("option_b")
  optionC      String       @map("option_c")
  optionD      String       @map("option_d")
  correctOption AnswerOption @map("correct_option")
  ageMin       Int          @map("age_min")
  ageMax       Int          @map("age_max")
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  answers Answer[]

  @@index([ageMin, ageMax])
  @@index([isActive])
  @@map("questions")
}

model QuizAttempt {
  id                   Int           @id @default(autoincrement())
  userId               Int           @map("user_id")
  status               AttemptStatus @default(IN_PROGRESS)
  // Fixed, ordered list of question IDs selected for this attempt at start time.
  // currentQuestionIndex is a position into this array (0-based).
  questionIds          Int[]         @map("question_ids")
  currentQuestionIndex Int           @default(0) @map("current_question_index")
  score                Int           @default(0)
  totalQuestions       Int           @map("total_questions")
  percentage           Float?
  timeLimitSeconds     Int           @map("time_limit_seconds")
  startedAt            DateTime      @default(now()) @map("started_at")
  lastActivityAt       DateTime      @default(now()) @updatedAt @map("last_activity_at")
  completedAt          DateTime?     @map("completed_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([userId, status])
  @@map("quiz_attempts")
}

model Answer {
  id             Int          @id @default(autoincrement())
  attemptId      Int          @map("attempt_id")
  questionId     Int          @map("question_id")
  selectedOption AnswerOption @map("selected_option")
  isCorrect      Boolean      @map("is_correct")
  answeredAt     DateTime     @default(now()) @map("answered_at")

  attempt  QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@index([attemptId])
  @@index([questionId])
  @@map("answers")
}
