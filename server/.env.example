# Copy this file to .env and fill in real values. Never commit .env.

# Local development: postgresql://<user>:<password>@localhost:5432/<database>
# Production (Phase 14): the connection string Neon gives you for this project.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/kids_bible_quiz"

# Port the Express API listens on locally. Render sets its own PORT in production.
PORT=4000

# Comma-separated list of origins allowed to call this API with credentials
# (the Expo dev server and, later, the deployed admin dashboard URL).
CORS_ORIGIN="http://localhost:8081,http://localhost:5173"

# Random secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace_with_a_random_64_char_hex_string"
