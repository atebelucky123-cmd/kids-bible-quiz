# Copy this file to .env and fill in real values. Never commit .env.

# Local development: postgresql://<user>:<password>@localhost:5432/<database>
# Production (Phase 14): Neon's *pooled* connection string for this project
# (hostname contains "-pooler"). Used for ordinary app queries.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/kids_bible_quiz"

# Prisma's migration commands always use this instead of DATABASE_URL — see
# schema.prisma's datasource comment. Locally there's no pooler, so this is
# just the same value as DATABASE_URL above. In production, this is Neon's
# *direct* (non-pooled) connection string — same host as DATABASE_URL minus
# "-pooler".
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/kids_bible_quiz"

# Port the Express API listens on locally. Render sets its own PORT in production.
PORT=4000

# Comma-separated list of origins allowed to call this API with credentials
# (the Expo dev server and, later, the deployed admin dashboard URL).
CORS_ORIGIN="http://localhost:8081,http://localhost:5173"

# Random secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace_with_a_random_64_char_hex_string"
